{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "moduleResolution": "bundler",
    "paths": {
      "@ecosgrti/security": ["./libs/security/src/index.ts"],
      "@ecosgrti/security/data-access": [
        "./libs/security/src/lib/data-access/index.ts"
      ],
      "@sgrti/core": ["./libs/core/src/index.ts"],
      "@app/workflow": ["./libs/workflow/src/index.ts"],
      "@ecosgrti/workflow": ["./libs/workflow/src/index.ts"]

    }
  },
  "exclude": ["node_modules", "tmp"]
}
